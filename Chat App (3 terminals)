Terminal C
#include <stdio.h>
#include <fcntl.h>
#include <sys/mman.h>
#include <unistd.h>
#include <string.h>

int main() {
    int shm_id = shm_open("/chat", O_CREAT | O_RDWR, 0777);
    ftruncate(shm_id, 4096);
    char *ptr = mmap(NULL, 4096, PROT_READ, MAP_SHARED, shm_id, 0);

    printf("[Terminal C] Monitoring chat. Type 'exit' from A or B to stop.\n");
    while (1) {
        if (strncmp(ptr, "exit", 4) == 0) break;
        printf("[Terminal C] Seen: %s", ptr);
        sleep(2);
    }

    munmap(ptr, 4096);
    close(shm_id);
    return 0;
}
