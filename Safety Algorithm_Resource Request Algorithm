#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

#define MAX_PROCESSES 10
#define MAX_RESOURCES 10

int allocation[MAX_PROCESSES][MAX_RESOURCES], 
    max[MAX_PROCESSES][MAX_RESOURCES], 
    need[MAX_PROCESSES][MAX_RESOURCES], 
    available[MAX_RESOURCES], 
    work[MAX_RESOURCES], 
    finish[MAX_PROCESSES];
int num_processes, num_resources;

void calculate_need() {
    int i,j;
    for(i = 0; i < num_processes; i++) {
        for(j = 0; j < num_resources; j++) {
            need[i][j] = max[i][j] - allocation[i][j];
        }
    }
}

//Safety Algorithm
bool is_system_safe() {
    int i,j;
    for(i = 0; i < num_resources; i++) {
        work[i] = available[i];
    }
    
    for(i = 0; i < num_processes; i++) {
        finish[i] = 0;
    }
    int safe_sequence[MAX_PROCESSES], count = 0;
    while(count < num_processes) {
        bool found = false;
        for(i = 0; i < num_processes; i++) {
            if (!finish[i]) {
                bool possible = true;
                for(j = 0; j < num_resources; j++) {
                    if(need[i][j] > work[j]) {
                        possible = false;
                        break;
                    }
                }
                if(possible == true) {
                    for(j = 0; j < num_resources; j++) {
                        work[j] += allocation[i][j];
                    }
                    safe_sequence[count++] = i;
                    finish[i] = 1;
                    found = true;
                }
            }
        }
        if (!found) {
            printf("\nSystem is in an unsafe state!\n");
            return false;
        }
    }
    printf("\nSystem is in a safe state!\n");
    printf("\nSafety sequence: ");
    for(i = 0; i < num_processes; i++) {
        printf("P%d\t", safe_sequence[i]);
    }
    printf("\n");
    return true;
}

// Resource Request Algorithm
bool request_resources(int process_id, int request[]) {
    int i,j;
    for(i = 0; i < num_resources; i++) {
        if(request[i] > need[process_id][i]) {
            printf("\nProcess id %d requested more than maximum need!\n", process_id);
            return false;
        }
        if(request[i] > available[i]) {
            printf("\nProcess P%d must wait. Insufficient resources available!\n", process_id);
            return false;
        }
    }
    for(i = 0; i< num_resources; i++) {
        available[i] -= request[i];
        allocation[process_id][i] += request[i];
        need[process_id][i] -= request[i];
    }
    if(is_system_safe()) {
        printf("\nRequest can be granted. The system remains in a safe state!\n");
        return true;
    }
    else {
        for(i = 0; i < num_resources; i++) {
            available[i] += request[i];
            allocation[process_id][i] -= request[i];
            need[process_id][i] += request[i];
        }
    printf("\nRequest denied to maintain system safety\n");
    return false;
  }
}
int main() {
    int i,j;
    printf("Enter the number of processes: ");
    scanf("%d", &num_processes);
    printf("\nEnter the number of resources: ");
    scanf("%d", &num_resources);
    
    printf("\nEnter the allocated resources:\n");
    for(i = 0; i < num_processes; i++) {
        printf("P%d: ",i);
        for(j = 0; j < num_resources; j++) {
            scanf("%d", &allocation[i][j]);
        }
    }

    printf("\nEnter the maximum resources:\n");
    for(i = 0; i < num_processes; i++) {
        printf("P%d: ",i);
        for(j = 0; j < num_resources; j++) {
            scanf("%d", &max[i][j]);
        }
    }
    
    printf("\nEnter the available resources:\n");
    for(i = 0; i < num_resources; i++) {
        scanf("%d", &available[i]);
    }
    calculate_need();   
    int choice;
    while(1) {
        printf("\nMenu:\n");
        printf("1. Safety Algorithm\n");
        printf("2. Resource Request Algorithm\n");
        printf("3. Exit\n");
        
        printf("Enter the choice: ");
        scanf("%d", &choice);
        
        if(choice == 1) {
            is_system_safe();
        }
        else if(choice == 2) {
            int process_id, request[MAX_RESOURCES];
            printf("\nEnter the process id: ");
            scanf("%d", &process_id);
            printf("\nEnter the request: ");
            for(i = 0; i < num_resources; i++) {
                scanf("%d", &request[i]);
            }
            request_resources(process_id, request);
        }
        else if(choice == 3) {
            printf("\nExiting the program!\n");
            exit(0);
        }
        else {
            printf("\nInvalid Choice!");
        }
    }
  return 0;
}
