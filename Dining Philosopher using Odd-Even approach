#include <wait.h>
#include <string.h>
#include <sys/types.h>
#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define NUM_PHIL 5

sem_t chopsticks[NUM_PHIL];

void think(int id) {
    printf("Philiosopher %d is thinking\n", id);
    sleep(1);
}

void eat(int id) {
    printf("Philosopher %d is eating\n", id);
    sleep(1);
}

void *philosopher(void *num) {
    int id = *((int*)num);
    free(num);
    
    while(1) {
        think (id);
        if(id % 2 == 0) {
            printf("Philosopher %d tries to pick up the left chopstick\n", id);        
            sem_wait(&chopsticks[id]);
            printf("Philosopher %d has picked up the left chopstick\n", id);
            
            printf("Philosopher %d tries to pick up the right chopstick\n", id);    
            sem_wait(&chopsticks[(id + 1) % NUM_PHIL]);
            printf("Philosopher %d has picked up the right chopstick\n", id);
        
    }
    else {
        printf("Philosopher %d tries to pick up the right chopstick\n", id);    
        sem_wait(&chopsticks[(id + 1) % NUM_PHIL]);
        printf("Philosopher %d has picked up the right chopstick\n", id);
        printf("Philosopher %d tries to pick up the left chopstick\n", id);        
        sem_wait(&chopsticks[id]);
        printf("Philosopher %d has picked up the left chopstick\n", id);

        
    }
        eat(id);
        
        sem_post(&chopsticks[id]);
        printf("Philosopher %d has put down left chopstick\n", id);
        sem_post(&chopsticks[(id + 1) % NUM_PHIL]);
        printf("Philosopher %d has put down right chopstick\n", id);
        
    }
}

int main() {
    int i, n;
    pthread_t philosophers[NUM_PHIL];
    sem_init(&chopsticks[i], 0, NUM_PHIL);
    
    for(i = 0; i < NUM_PHIL; i++) {
        sem_init(&chopsticks[i], 0 , 1);
    }
    for(i = 0; i < NUM_PHIL; i ++) {
        int *id = malloc(sizeof(int));
        *id = i;
        
        pthread_create(&philosophers[i],NULL, philosopher, id);
    }
    
    for(i = 0; i < NUM_PHIL; i++) {
        pthread_join(philosophers[i], NULL);
    }
    for(i = 0; i < NUM_PHIL; i++) {
        sem_destroy(&chopsticks[i]);
    }
return 0;
}
