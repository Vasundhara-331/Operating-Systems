void lru (int pages[], int pageCount, int frameCount) {
    int frames[MAX_FRAMES], timestamps[MAX_FRAMES];
    int time = 0, pageFaults = 0;
    int i, j;
    
    for(i = 0; i < frameCount; i++) {
        frames[i] = -1;
        timestamps[i] = -1;
    }
    
    for(i = 0; i < pageCount; i++) {
        int pos = isPageInFrames(frames, pages[i], frameCount);
        
    if(pos == -1) {
        int lruIndex = 0;
        for(j = 1; j < frameCount; j++) {
            if(timestamps[j] < timestamps[lruIndex]) 
                lruIndex = j;
        }
                frames[lruIndex] = pages[i];
                  printf("\nPage %d ->  ", pages[i]);
            for(j = 0; j < frameCount; j++) {
                printf("%d  ", frames[j]);
            }
                pageFaults++;
                timestamps[lruIndex] = time++;
            }
            else {
                timestamps[pos] = time++;
            }
    }
    printf("\nPage Faults: %d", pageFaults);
    printf("\n");
}

void LFU (int pages[], int pageCount, int frameCount) {
    int frames[MAX_FRAMES], frequency[MAX_FRAMES], age[MAX_FRAMES];
    int time = 0, pageFaults = 0;
    int i, j;
    
    for(i = 0; i < frameCount; i++) {
        frames[i] = -1;
        frequency[i] = 0;
        age[i] = 0;
    }
    
    for(i = 0; i < pageCount; i++) {
    int index = isPageInFrames(frames, pages[i], frameCount);
    if(index == -1) {
      int replace_index = -1;
      int min_freq = 99999, oldest_age = -1;
      for(j = 0; j < frameCount; j++) {
        if(frames[j] == -1) {
          replace_index = j;
          break;
        }
        else if(frequency[j] < min_freq || ((frequency[j] == min_freq) && age[j] < oldest_age)) {
          replace_index = j;
          min_freq = frequency[j];
          oldest_age = age[j];
        }
      }
      frames[replace_index] = pages[i];
      frequency[replace_index] = 1;
      age[replace_index] = i;
      pageFaults++;
      printf("\nPage: %d -> ",pages[i]);
      for(j = 0; j < frameCount; j++) {
                printf("%d  ", frames[j]);
            }
       }
       else {
        frequency[index]++;
      }
    }
      printf("\nTotal page faults: %d", pageFaults);
  }
  
