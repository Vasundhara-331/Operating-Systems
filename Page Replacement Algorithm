#define MAX_FRAMES 10
#define MAX_PAGES 100

int isPageInFrames(int frames[], int page, int pageCount) {
    int i;
    for(i = 0; i< pageCount; i++) {
        if(frames[i] == page) {
            return i;
        }
    }
        return -1;
}

