#include <stdio.h>
#include <string.h>
#include <stdlib.h>

struct Process {
    int pid;
    int arrival;
    int burst;
    int priority;
    int waiting;
    int turnaround;
    int remaining;
    int completion;
};

void swap(struct Process *a, struct Process *b) {
    struct Process temp = *a;
    *a = *b;
    *b = temp;
}

// FIRST COME FIRST SERVE (FCFS)
void fcfs(struct Process p[], int n) {
    int i, j;
    float sum_ta = 0.0, sum_wt = 0.0;
    int completion_time = 0;

    // Sort by arrival time
    for(i = 0; i < n - 1; i++) {
        for(j = 0; j < n - i - 1; j++) {
            if(p[j].arrival > p[j+1].arrival) {
                swap(&p[j], &p[j+1]);
            }
        }
    }

    printf("\nGantt Chart:\n0");
    for(i = 0; i < n; i++) {
        if(completion_time < p[i].arrival)
            completion_time = p[i].arrival;

        completion_time += p[i].burst;
        p[i].completion = completion_time;
        p[i].turnaround = completion_time - p[i].arrival;
        p[i].waiting = p[i].turnaround - p[i].burst;

        printf("|P%d|%d", p[i].pid, completion_time);

        sum_ta += p[i].turnaround;
        sum_wt += p[i].waiting;
    }

    printf("\nAverage Turnaround Time: %.2f", sum_ta / n);
    printf("\nAverage Waiting Time: %.2f", sum_wt / n);
}

// NON-PREEMPTIVE SHORTEST JOB FIRST (SJF)
void sjf(struct Process p[], int n) {
    int i, completion_time = 0, completed = 0, min_index;
    float sum_ta = 0.0, sum_wt = 0.0;

    for(i = 0; i < n; i++) {
        p[i].remaining = p[i].burst;
    }

    printf("\nGantt Chart:\n0");
    while(completed < n) {
        min_index = -1;

        for(i = 0; i < n; i++) {
            if(p[i].arrival <= completion_time && p[i].remaining > 0) {
                if(min_index == -1 || p[i].burst < p[min_index].burst)
                    min_index = i;
            }
        }

        if(min_index == -1) {
            completion_time++;
            continue;
        }

        completion_time += p[min_index].burst;
        p[min_index].completion = completion_time;
        p[min_index].turnaround = p[min_index].completion - p[min_index].arrival;
        p[min_index].waiting = p[min_index].turnaround - p[min_index].burst;
        p[min_index].remaining = 0;
        completed++;

        printf("|P%d|%d", p[min_index].pid, completion_time);

        sum_ta += p[min_index].turnaround;
        sum_wt += p[min_index].waiting;
    }

    printf("\nAverage Turnaround Time: %.2f", sum_ta / n);
    printf("\nAverage Waiting Time: %.2f", sum_wt / n);
}

// ROUND ROBIN
void rr(struct Process p[], int n, int quantum) {
    int time = 0, completed = 0;
    float sum_ta = 0.0, sum_wt = 0.0;
    int i;
    
    for(i = 0; i < n; i++) {
        p[i].remaining = p[i].burst;
    }

    printf("\nGantt Chart:\n0");
    while(completed < n) {
        int done = 0;

        for(i = 0; i < n; i++) {
            if(p[i].remaining > 0 && p[i].arrival <= time) {
                if(p[i].remaining > quantum) {
                    time += quantum;
                    p[i].remaining -= quantum;
                } else {
                    time += p[i].remaining;
                    p[i].completion = time;
                    p[i].turnaround = p[i].completion - p[i].arrival;
                    p[i].waiting = p[i].turnaround - p[i].burst;
                    sum_ta += p[i].turnaround;
                    sum_wt += p[i].waiting;
                    p[i].remaining = 0;
                    completed++;
                }
                printf("|P%d|%d", p[i].pid, time);
                done = 1;
            }
        }

        if (!done) time++; // If no process executed, move time forward
    }

    printf("\nAverage Turnaround Time: %.2f", sum_ta / n);
    printf("\nAverage Waiting Time: %.2f", sum_wt / n);
}

// NON-PREEMPTIVE PRIORITY SCHEDULING
void priority_scheduling(struct Process p[], int n) {
    int i, completion_time = 0, completed = 0, highest_priority;
    float sum_ta = 0.0, sum_wt = 0.0;

    for(i = 0; i < n; i++) {
        p[i].remaining = p[i].burst;
    }

    printf("\nGantt Chart:\n0");
    while(completed < n) {
        highest_priority = -1;

        for(i = 0; i < n; i++) {
            if(p[i].arrival <= completion_time && p[i].remaining > 0) {
                if(highest_priority == -1 || p[i].priority < p[highest_priority].priority)
                    highest_priority = i;
            }
        }

        if(highest_priority == -1) {
            completion_time++;
            continue;
        }

        completion_time += p[highest_priority].burst;
        p[highest_priority].completion = completion_time;
        p[highest_priority].turnaround = p[highest_priority].completion - p[highest_priority].arrival;
        p[highest_priority].waiting = p[highest_priority].turnaround - p[highest_priority].burst;
        p[highest_priority].remaining = 0;
        completed++;

        printf("|P%d|%d", p[highest_priority].pid, completion_time);

        sum_ta += p[highest_priority].turnaround;
        sum_wt += p[highest_priority].waiting;
    }

    printf("\nAverage Turnaround Time: %.2f", sum_ta / n);
    printf("\nAverage Waiting Time: %.2f", sum_wt / n);
}

int main() {
    int i, n, choice, quantum;
    printf("\nEnter the number of processes: ");
    scanf("%d", &n);
    struct Process p[n];

    for(i = 0; i < n; i++) {
        p[i].pid = i+1;
        printf("\nEnter Arrival Time, Burst Time and Priority for Process %d:\n", i+1);
        printf("Arrival Time: ");
        scanf("%d", &p[i].arrival);
        printf("Burst Time: ");
        scanf("%d", &p[i].burst);
        printf("Priority (lower number = higher priority): ");
        scanf("%d", &p[i].priority);
    }

    printf("\nEnter the Time Quantum for Round Robin: ");
    scanf("%d", &quantum);

    while(1) {
        printf("\n--- Scheduling Menu ---\n");
        printf("1. FCFS\n2. SJF\n3. Round Robin\n4. Priority Scheduling\n5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                fcfs(p, n);
                break;
            case 2:
                sjf(p, n);
                break;
            case 3:
                rr(p, n, quantum);
                break;
            case 4:
                priority_scheduling(p, n);
                break;
            case 5:
                printf("Exiting program.\n");
                exit(0);
            default:
                printf("Invalid choice. Try again.\n");
        }

        printf("\n\nPID\tAT\tBT\tCT\tTA\tWT\n");
        for(i = 0; i < n; i++) {
            printf("%d\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].arrival, p[i].burst,
                   p[i].completion, p[i].turnaround, p[i].waiting);
        }
    }

    return 0;
}
