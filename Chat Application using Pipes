#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>

#define SIZE 1024

int main() {
    int pipe1[2]; // Parent -> Child
    int pipe2[2]; // Child -> Parent
    char msg[SIZE];
    int status;

    if (pipe(pipe1) == -1 || pipe(pipe2) == -1) {
        perror("Pipe failed");
        exit(1);
    }

    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        exit(1);
    }

    else if (pid > 0) {
        // Parent Process
        close(pipe1[0]); // Close read end of pipe1
        close(pipe2[1]); // Close write end of pipe2

        while (1) {
            printf("\n[Parent] Enter message: ");
            fgets(msg, SIZE, stdin);
            write(pipe1[1], msg, strlen(msg) + 1);

            if (strcmp(msg, "exit\n") == 0) break;

            read(pipe2[0], msg, SIZE);
            if (strcmp(msg, "exit\n") == 0) break;

            printf("[Parent] Child replied: %s", msg);
        }

        close(pipe1[1]);
        close(pipe2[0]);
        wait(&status);
    }

    else {
        // Child Process
        close(pipe1[1]); // Close write end of pipe1
        close(pipe2[0]); // Close read end of pipe2

        while (1) {
            read(pipe1[0], msg, SIZE);
            if (strcmp(msg, "exit\n") == 0) break;

            printf("[Child] Parent wrote: %s", msg);
            printf("[Child] Enter reply: ");
            fgets(msg, SIZE, stdin);
            write(pipe2[1], msg, strlen(msg) + 1);

            if (strcmp(msg, "exit\n") == 0) break;
        }

        close(pipe1[0]);
        close(pipe2[1]);
    }

    return 0;
}
