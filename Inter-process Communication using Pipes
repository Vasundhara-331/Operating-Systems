#include <sys/types.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

#define MAX 10

int main() {
    int fd1[2], fd2[2], fd3[2];  
    int a[MAX];
    pid_t p1, p2;
    int n, status;
    int sum = 0;

    printf("Enter the limit (max %d): ", MAX);
    scanf("%d", &n);

    if (n > MAX) {
        printf("Limit exceeds max size!\n");
        exit(1);
    }

    pipe(fd1);
    pipe(fd2);
    pipe(fd3);

    p1 = fork();

    if (p1 == 0) {
        // Child 1: receive array and square it
        close(fd1[1]); // close write end
        read(fd1[0], a, n * sizeof(int));
        close(fd1[0]);

        printf("\nSquared Array: ");
        for (int i = 0; i < n; i++) {
            a[i] = a[i] * a[i];
            printf("%d ", a[i]);
        }
        printf("\n");

        // Send squared array to parent via fd3
        close(fd3[0]);
        write(fd3[1], a, n * sizeof(int));
        close(fd3[1]);

        // Fork child 2 for sum
        p2 = fork();

        if (p2 == 0) {
            // Child 2: read squared array and compute sum
            close(fd2[1]);
            read(fd2[0], a, n * sizeof(int));
            close(fd2[0]);

            for (int i = 0; i < n; i++) {
                sum += a[i];
            }
            printf("Sum of squared elements: %d\n", sum);
        }
    }
    else if (p1 > 0) {
        // Parent: take input
        printf("\nRead array:\n");
        for (int i = 0; i < n; i++) {
            scanf("%d", &a[i]);
        }

        // Send array to child 1
        close(fd1[0]);
        write(fd1[1], a, n * sizeof(int));
        close(fd1[1]);

        // Wait for child 1 to finish
        wait(&status);

        // Send squared array to child 2 via fd2
        close(fd2[0]);
        write(fd2[1], a, n * sizeof(int));
        close(fd2[1]);
    }
    else {
        printf("\nProcess Failed!\n");
    }

    return 0;
}
