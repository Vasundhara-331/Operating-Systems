#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

#define MAX 10

int main() {
    int fd1[2], fd2[2], fd3[2];
    int a[MAX];
    pid_t p1,p2;
    int n, status, sum = 0;
    
    printf("Enter the limit: ");
    scanf("%d", &n);
    
    pipe(fd1);
    pipe(fd2);
    pipe(fd3);
    
    p1 = fork();
    if(p1 > 0) {
        printf("Enter the values: ");
        for(int i = 0; i < n; i++) {
            scanf("%d", &a[i]);
        }
        close(fd1[0]);
        write(fd1[1],a,n*sizeof(int));
        close(fd1[1]);
        
        wait(&status);
        
        close(fd3[1]);
        read(fd3[0],&sum,n*sizeof(int));
        close(fd3[0]);
        printf("Sum is: %d", sum);
    }
    else if (p1 == 0){
        close(fd1[1]);
        read(fd1[0],a,n*sizeof(int));
        close(fd1[0]);
    
        printf("\nSquared Array: ");
        for (int i = 0; i < n; i++) {
            a[i] = a[i] * a[i];
            printf("%d ", a[i]);
        }
        printf("\n");
        
        close(fd2[0]);
        write(fd2[1],a,n*sizeof(int));
        close(fd2[1]);
        
        p2 = fork();
        if(p2 == 0) {
            close(fd2[1]);
            read(fd2[0],a,n*sizeof(int));
            close(fd2[0]);
            
            for(int i = 0; i < n; i++) {
                sum += a[i];
            }
            close(fd3[0]);
            write(fd3[1],&sum,n*sizeof(int));
            close(fd3[1]);
        }
}
        
        else {
            printf("Fork creation failed");
        }
        return 0;
}
